# WhatsApp number for the chat button and footer, international format, e.g. 2547XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Shop email shown in the footer
NEXT_PUBLIC_CONTACT_EMAIL=
# Pickup point shown in the footer, e.g. "Shop 12, Yaya Centre"
NEXT_PUBLIC_PICKUP_POINT=
# Pickup opening hours, e.g. "Mon–Sat, 10am–6pm"
NEXT_PUBLIC_PICKUP_HOURS=
# Google Maps link for the pickup point
NEXT_PUBLIC_PICKUP_MAP_URL=
# Absolute site URL for Open Graph images and structured data, e.g. https://example.co.ke
NEXT_PUBLIC_SITE_URL=
